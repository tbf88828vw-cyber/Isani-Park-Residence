# Copy the names into Vercel → Project → Settings → Environment Variables.
# Never commit real values. At least one delivery channel must be set,
# otherwise the form honestly reports that the request was not delivered.

# Public address of the site (canonical, hreflang, sitemap, Open Graph)
SITE_URL=https://example.ge

# Channel 1: Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Channel 2: e-mail via Resend
RESEND_API_KEY=
LEAD_EMAIL_FROM=
LEAD_EMAIL_TO=

# Channel 3: webhook (CRM, Make, Zapier…)
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=

# Domains allowed to post the form, comma-separated (e.g. https://example.ge,https://www.example.ge)
ALLOWED_ORIGINS=
